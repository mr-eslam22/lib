<Window x:Class="WindowsPrintAutomation.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsPrintAutomation.UI.ViewModels"
        xmlns:views="clr-namespace:WindowsPrintAutomation.UI.Views"
        Title="نظام أتمتة وإدارة الطباعة المدرسية — Windows Print Automation System"
        Height="740" Width="1180"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
            <views:PrintersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintQueueViewModel}">
            <views:PrintQueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecoveryViewModel}">
            <views:RecoveryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorLogsViewModel}">
            <views:ErrorLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Branding Header -->
                <Border DockPanel.Dock="Top" Padding="20,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="مطبعة الكتب المدرسية" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="إدارة الطباعة وماكينات HP وKyocera" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,16">
                    <StackPanel>
                        <RadioButton Content="📊  لوحة التحكم الرئيسية" Style="{StaticResource NavButton}" IsChecked="True" Click="Nav_Dashboard_Click" />
                        <RadioButton Content="📚  مكتبة وفهرسة الكتب" Style="{StaticResource NavButton}" Click="Nav_Library_Click" />
                        <RadioButton Content="👥  دليل العملاء" Style="{StaticResource NavButton}" Click="Nav_Customers_Click" />
                        <RadioButton Content="🛒  الطلبات وإنشاء طلب" Style="{StaticResource NavButton}" Click="Nav_Orders_Click" />
                        <RadioButton Content="🖨️  الماكينات وملفات التعريف" Style="{StaticResource NavButton}" Click="Nav_Printers_Click" />
                        <RadioButton Content="⏳  طابور الطباعة والتأكيد" Style="{StaticResource NavButton}" Click="Nav_Queue_Click" />

                        <Separator Background="{StaticResource BorderBrush}" Margin="8,10" />

                        <!-- Recovery with Alert Badge -->
                        <Grid Margin="0,2">
                            <RadioButton Content="⚠️  استعادة المهام المتوقفة" Style="{StaticResource NavButton}" Click="Nav_Recovery_Click" />
                            <Border Background="{StaticResource WarningBrush}" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,2" Margin="0,0,12,0"
                                    Visibility="{Binding HasActiveRecoveryAlert, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnverifiedJobsCount}" FontSize="11" FontWeight="Bold" Foreground="Black" />
                            </Border>
                        </Grid>

                        <!-- Error Logs -->
                        <Grid Margin="0,2">
                            <RadioButton Content="📋  سجل الأخطاء والتدقيق" Style="{StaticResource NavButton}" Click="Nav_ErrorLogs_Click" />
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,2" Margin="0,0,12,0"
                                    Visibility="{Binding HasUnresolvedErrors, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnresolvedErrorsCount}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>

                        <RadioButton Content="⚙️  الإعدادات والنسخ الاحتياطي" Style="{StaticResource NavButton}" Click="Nav_Settings_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0,12,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Section title and status -->
                        <ColumnDefinition Width="*" />
                        <!-- Alert pill -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Window Caption Controls (Minimize, Maximize, Close) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveSectionTitle}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgTertiary}" CornerRadius="6" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SystemStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                        </Border>
                    </StackPanel>

                    <!-- Alert pill if crash / recovery required -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="#451A03" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6"
                                Visibility="{Binding HasActiveRecoveryAlert, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚠️ يلزم التحقق من مهام متوقفة بعد إعادة التشغيل" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowCaptionButton}" Click="BtnMinimize_Click" ToolTip="تصغير النافذة">
                            <TextBlock Text="—" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximizeRestore" Style="{StaticResource WindowCaptionButton}" Click="BtnMaximize_Click" ToolTip="تكبير / استعادة">
                            <TextBlock x:Name="TxtMaximizeIcon" Text="🗖" FontSize="13" Foreground="{StaticResource TextMuted}" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="إغلاق البرنامج">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Body Wrapped in Responsive ScrollViewer -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl Content="{Binding CurrentView}" Margin="16,14" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
