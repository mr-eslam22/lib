<UserControl x:Class="WindowsPrintAutomation.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Customers Table -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="قائمة وسجل العملاء" FontSize="16" FontWeight="Bold" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,8,0,0" ToolTip="ابحث بالاسم أو رقم الهاتف أو كود العميل" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود العميل" Binding="{Binding CustomerCode}" Width="120" />
                        <DataGridTextColumn Header="اسم العميل" Binding="{Binding FullName}" Width="180" />
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="140" />
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                        <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy/MM/dd\}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- New Customer Form -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="تسجيل عميل جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="اسم العميل الكامل:" Margin="0,0,0,4" Foreground="{StaticResource TextMuted}" />
                <TextBox x:Name="TxtName" Margin="0,0,0,12" />

                <TextBlock Text="رقم الهاتف:" Margin="0,0,0,4" Foreground="{StaticResource TextMuted}" />
                <TextBox x:Name="TxtPhone" Margin="0,0,0,12" />

                <TextBlock Text="ملاحظات العميل:" Margin="0,0,0,4" Foreground="{StaticResource TextMuted}" />
                <TextBox x:Name="TxtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                <Button Content="💾  حفظ العميل" Style="{StaticResource PrimaryButton}" Click="BtnSaveCustomer_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
