<UserControl x:Class="WindowsPrintAutomation.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action & Search Bar with Responsive WrapPanel -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <!-- Import Folder Button -->
                <Button Content="📁  استيراد مجلد الكتب بالكامل" Style="{StaticResource PrimaryButton}" Click="BtnImportFolder_Click" Margin="0,0,14,6" VerticalAlignment="Center" />

                <!-- Search Input -->
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Width="260" VerticalAlignment="Center" Margin="0,0,14,6" ToolTip="ابحث باسم الكتاب، المادة، أو الصف" />

                <!-- Grade Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                    <TextBlock Text="الصف:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" Width="150" />
                </StackPanel>

                <!-- Subject Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                    <TextBlock Text="المادة:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" Width="150" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Import Status Message -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                Visibility="{Binding HasImportStatus, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️  " FontSize="14" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ImportStatusMessage}" FontSize="13" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Books DataGrid with Full Scrollability -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
            <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الكتاب" Binding="{Binding Title}" Width="220" />
                    <DataGridTextColumn Header="الصف الدراسي" Binding="{Binding Grade}" Width="140" />
                    <DataGridTextColumn Header="المادة" Binding="{Binding Subject}" Width="140" />
                    <DataGridTextColumn Header="عدد الصفحات" Binding="{Binding PageCount}" Width="100" />
                    <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="180" />
                    <DataGridTextColumn Header="المسار الأصلي على القرص" Binding="{Binding FilePath}" Width="*" />
                    <DataGridTemplateColumn Header="إجراء سريع" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🛒 طلب طباعة" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="BtnOrderBook_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
