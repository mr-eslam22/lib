<UserControl x:Class="WindowsPrintAutomation.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action & Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Import Folder Button -->
                <Button Grid.Column="0" Content="📁  استيراد مجلد الكتب بالكامل" Style="{StaticResource PrimaryButton}" Click="BtnImportFolder_Click" Margin="0,0,16,0" />

                <!-- Search Input -->
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="ابحث باسم الكتاب، المادة، أو الصف" />

                <!-- Grade Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="الصف:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" Width="160" />
                </StackPanel>

                <!-- Subject Filter -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المادة:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" Width="160" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Import Status Message -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                Visibility="{Binding ImportStatusMessage, Converter={x:Static BooleanToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️  " FontSize="14" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ImportStatusMessage}" FontSize="13" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
        </Border>

        <!-- Books DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
            <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الكتاب" Binding="{Binding Title}" Width="250" />
                    <DataGridTextColumn Header="الصف الدراسي" Binding="{Binding Grade}" Width="160" />
                    <DataGridTextColumn Header="المادة" Binding="{Binding Subject}" Width="160" />
                    <DataGridTextColumn Header="عدد الصفحات" Binding="{Binding PageCount}" Width="110" />
                    <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="200" />
                    <DataGridTextColumn Header="المسار الأصلي على القرص" Binding="{Binding FilePath}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
