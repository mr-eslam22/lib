<UserControl x:Class="WindowsPrintAutomation.UI.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WindowsPrintAutomation.Core.Domain.Enums;assembly=WindowsPrintAutomation.Core"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & New Order Trigger -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="سجل الطلبات" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="300" ToolTip="ابحث برقم الطلب أو اسم العميل" />
                </StackPanel>

                <Button Grid.Column="1" Content="➕  إنشاء طلب طباعة جديد" Style="{StaticResource PrimaryButton}" Click="BtnNewOrder_Click" />
            </Grid>
        </Border>

        <!-- Orders Table -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="160" />
                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="180" />
                    <DataGridTextColumn Header="هاتف العميل" Binding="{Binding CustomerPhone}" Width="140" />
                    <DataGridTextColumn Header="عدد الكتب" Binding="{Binding TotalItemsCount}" Width="100" />
                    <DataGridTextColumn Header="تقدير الأوراق" Binding="{Binding TotalEstimatedSheets}" Width="110" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy/MM/dd HH:mm\}}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- New Order Modal Popup -->
        <Grid x:Name="NewOrderModal" Grid.RowSpan="2" Background="#CC0F172A" Visibility="Collapsed">
            <Border Style="{StaticResource CardPanel}" Width="950" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BgSecondary}">
                <DockPanel LastChildFill="True">
                    <!-- Modal Header -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                        <Grid>
                            <TextBlock Text="إنشاء ومراجعة طلب طباعة جديد" FontSize="18" FontWeight="Bold" />
                            <Button Content="✕" HorizontalAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="BtnCloseModal_Click" />
                        </Grid>
                    </Border>

                    <!-- Modal Actions Bottom -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الأوراق المقدرة:" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TotalDraftSheets}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text=" ورقة" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="إلغاء" Style="{StaticResource GhostButton}" Click="BtnCloseModal_Click" Margin="0,0,10,0" />
                                <Button Content="✅  تأكيد وإرسال إلى طابور الطباعة" Style="{StaticResource SuccessButton}" Click="BtnConfirmOrder_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Modal Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16">
                        <StackPanel>
                            <!-- Customer Selection -->
                            <TextBlock Text="العميل والماكينة:" FontWeight="Bold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="اختر العميل:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="الماكينة المستهدفة:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedValuePath="WindowsPrinterName" SelectedValue="{Binding SelectedPrinterName}" DisplayMemberPath="WindowsPrinterName" />
                                </StackPanel>
                            </Grid>

                            <!-- Add Book to Draft -->
                            <TextBlock Text="إضافة كتاب إلى الطلب:" FontWeight="Bold" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbAvailableBooks" Grid.Column="0" DisplayMemberPath="Title" Margin="0,0,12,0" />
                                <Button Grid.Column="1" Content="➕ إضافة الكتاب" Style="{StaticResource PrimaryButton}" Click="BtnAddBookToDraft_Click" />
                            </Grid>

                            <!-- Selected Items in Order -->
                            <TextBlock Text="الكتب المختارة وإعدادات الطباعة لكل كتاب:" FontWeight="Bold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding DraftItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Book.Title}" FontWeight="Bold" FontSize="14" />
                                                        <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding Book.Grade}" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text=" - " Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding Book.Subject}" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text=" | " Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding Book.PageCount}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                        <TextBlock Text=" صفحة)" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                    <Button Content="حذف" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,2" FontSize="11" Click="BtnRemoveDraftItem_Click" />
                                                </Grid>

                                                <!-- Per-Book Print Settings -->
                                                <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,0">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="عدد النسخ:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="مقاس الورق:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <ComboBox SelectedItem="{Binding PaperSize}">
                                                            <enums:PaperSizeOption>A4</enums:PaperSizeOption>
                                                            <enums:PaperSizeOption>B5</enums:PaperSizeOption>
                                                            <enums:PaperSizeOption>Custom</enums:PaperSizeOption>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="الوجهين:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <ComboBox SelectedItem="{Binding Duplex}">
                                                            <enums:PrintDuplexOption>DuplexLongEdge</enums:PrintDuplexOption>
                                                            <enums:PrintDuplexOption>Simplex</enums:PrintDuplexOption>
                                                            <enums:PrintDuplexOption>DuplexShortEdge</enums:PrintDuplexOption>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="الألوان:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <ComboBox SelectedItem="{Binding ColorMode}">
                                                            <enums:PrintColorOption>Monochrome</enums:PrintColorOption>
                                                            <enums:PrintColorOption>Color</enums:PrintColorOption>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock Text="الأوراق المقدرة:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding EstimatedSheets}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Notes -->
                            <TextBlock Text="ملاحظات الطلب الإضافية:" Margin="0,8,0,4" Foreground="{StaticResource TextMuted}" />
                            <TextBox Text="{Binding OrderNotes}" Height="50" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
