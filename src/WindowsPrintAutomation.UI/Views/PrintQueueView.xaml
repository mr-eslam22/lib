<UserControl x:Class="WindowsPrintAutomation.UI.Views.PrintQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Note -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="طابور مهام الطباعة ونظام التحقق الفيزيائي" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="تنبيه: لا يتم اعتبار أي مهمة مكتملة بمجرد انتهاء إرسال Spooler؛ يجب التحقق الفيزيائي من النسخ وتأكيدها." FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="🔄  تحديث الطابور" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Click="BtnRefresh_Click" />
            </Grid>
        </Border>

        <!-- Queue Table -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <DataGrid ItemsSource="{Binding ActiveJobs}" SelectedItem="{Binding SelectedJob}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المهمة" Binding="{Binding JobNumber}" Width="150" />
                    <DataGridTextColumn Header="الماكينة" Binding="{Binding PrinterName}" Width="160" />
                    <DataGridTextColumn Header="المطلوب" Binding="{Binding CopiesRequested}" Width="80" />
                    <DataGridTextColumn Header="المؤكد سليم" Binding="{Binding CopiesVerified}" Width="90" />
                    <DataGridTextColumn Header="التالف" Binding="{Binding CopiesDamaged}" Width="70" />
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding CopiesRemaining}" Width="80" />
                    <DataGridTextColumn Header="حالة المهمة" Binding="{Binding Status}" Width="130" />
                    <DataGridTextColumn Header="مستوى التحقق" Binding="{Binding VerificationStatus}" Width="140" />
                    <DataGridTemplateColumn Header="إجراءات الموظف" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔍 تأكيد فيزيائي / استكمال" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" Margin="0,0,8,0" Click="BtnVerify_Click" />
                                    <Button Content="إلغاء" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" Click="BtnCancel_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
