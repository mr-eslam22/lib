<UserControl x:Class="WindowsPrintAutomation.UI.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WindowsPrintAutomation.Core.Domain.Enums;assembly=WindowsPrintAutomation.Core"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Discovery & Action Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إدارة ماكينات الطباعة وتعدد الشركات (HP, Kyocera, Canon, Ricoh)" FontSize="16" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔍  اكتشاف طابعات Windows تلقائيًا" Style="{StaticResource PrimaryButton}" Click="BtnDiscoverPrinters_Click" Margin="0,0,10,0" />
                    <Button Content="⚡  فحص الاتصال والقدرات" Style="{StaticResource SuccessButton}" Click="BtnTestConnection_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Printers Table & Configuration Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Printers List -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="الماكينات المعتمدة في النظام" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                    <DataGrid ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الطابعة" Binding="{Binding WindowsPrinterName}" Width="180" />
                            <DataGridTextColumn Header="الشركة" Binding="{Binding Manufacturer}" Width="90" />
                            <DataGridTextColumn Header="المحول (Adapter)" Binding="{Binding AdapterFamily}" Width="130" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding CurrentStatusText}" Width="100" />
                            <DataGridCheckBoxColumn Header="مفعلة" Binding="{Binding IsActive}" Width="60" />
                            <DataGridTemplateColumn Header="التحكم" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding IsPaused, Converter={x:Null}}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="BtnTogglePause_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Content" Value="إيقاف" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Content" Value="تشغيل" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="{Binding IsActive, Converter={x:Null}}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="6,2" FontSize="11" Click="BtnToggleActive_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Content" Value="تعطيل" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content" Value="تفعيل" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: Tabbed Configuration & Diagnostics -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Capability Probe Results -->
                    <TabItem Header="فحص التوافق والقدرات">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="نتائج فحص الاتصال وقدرات التعريف المؤكدة:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

                                <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="الماكينة المختارة:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding SelectedPrinter.WindowsPrinterName}" FontSize="15" FontWeight="Bold" Margin="0,2,0,6" />
                                        <TextBlock Text="اسم تعريف الطباعة (Driver):" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding SelectedPrinter.DriverName, TargetNullValue='غير محدد'}" FontSize="13" Margin="0,2,0,6" />
                                        <TextBlock Text="منفذ الاتصال / IP:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding SelectedPrinter.ConnectionAddress, TargetNullValue='منفذ محلي'}" FontSize="13" Margin="0,2,0,6" />
                                        <TextBlock Text="نتيجة آخر اختبار اتصال:" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding SelectedPrinter.TestResultStatus, TargetNullValue='لم يتم الفحص بعد'}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Confirmed Capabilities List -->
                                <TextBlock Text="القدرات المؤكدة رسميًا من تعريف الطابعة (جاهزة للاستخدام):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding ConfirmedCapabilities}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14532D" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StringFormat='✔  {0}'}" FontSize="12" Foreground="#86EFAC" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Unconfirmed Capabilities List -->
                                <TextBlock Text="القدرات غير المؤكدة أو المجهولة (تتطلب مراجعة بشرية):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding UnconfirmedCapabilities}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#451A03" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StringFormat='⚠️  {0}'}" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Unsupported Capabilities List -->
                                <TextBlock Text="الخيارات غير المدعومة:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding UnsupportedCapabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#450A0A" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StringFormat='✖  {0}'}" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Adapter & Hardware Settings -->
                    <TabItem Header="تخصيص الماكينة والمحول">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel DataContext="{Binding SelectedPrinter}">
                                <TextBlock Text="اسم العرض للماكينة داخل التطبيق:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding WindowsPrinterName}" Margin="0,0,0,12" />

                                <TextBlock Text="الشركة المصنّعة:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Manufacturer}" Margin="0,0,0,12" />

                                <TextBlock Text="الموديل:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Model}" Margin="0,0,0,12" />

                                <TextBlock Text="محول الطابعة (Adapter Architecture):" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DataContext.AvailableAdapters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding AdapterFamily}" Margin="0,0,0,12" />

                                <TextBlock Text="عنوان IP أو المنفذ:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ConnectionAddress}" Margin="0,0,0,12" />

                                <TextBlock Text="المقاسات المعتمدة (مفصولة بفواصل):" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SupportedPaperSizes}" Margin="0,0,0,12" />

                                <TextBlock Text="الأدراج المتاحة:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AvailableTrays}" Margin="0,0,0,16" />

                                <Button Content="💾  حفظ إعدادات الماكينة" Style="{StaticResource PrimaryButton}" Click="BtnSavePrinter_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Profiles by Book Type -->
                    <TabItem Header="ملفات الإعدادات (Profiles)">
                        <DockPanel LastChildFill="True" Margin="0,12,0,0">
                            <Button DockPanel.Dock="Top" Content="➕  إضافة ملف تعريف جديد للماكينة" Style="{StaticResource PrimaryButton}" Click="BtnAddProfile_Click" Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="14" />
                                                    <TextBlock Text="{Binding TargetBookType, StringFormat='نوع المطبوعات: {0}'}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding PaperSize}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Duplex}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ColorMode}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding PaperTray}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </TabItem>

                    <!-- Tab 4: Machine Error History -->
                    <TabItem Header="سجل أخطاء الماكينة">
                        <DataGrid ItemsSource="{Binding MachineErrors}" Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الوقت" Binding="{Binding Timestamp, StringFormat=\{0:yyyy/MM/dd HH:mm\}}" Width="130" />
                                <DataGridTextColumn Header="نوع الخطأ" Binding="{Binding ErrorType}" Width="120" />
                                <DataGridTextColumn Header="المصدر" Binding="{Binding ErrorSource}" Width="110" />
                                <DataGridTextColumn Header="رسالة الخطأ" Binding="{Binding ErrorMessage}" Width="*" />
                                <DataGridCheckBoxColumn Header="تم الحل" Binding="{Binding IsResolved}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
