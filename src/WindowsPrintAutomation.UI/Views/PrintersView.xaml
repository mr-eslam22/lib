<UserControl x:Class="WindowsPrintAutomation.UI.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Printers List -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="ماكينات الطباعة المتصلة وملفات التعريف (HP &amp; Kyocera)" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <DataGrid ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الطابعة في Windows" Binding="{Binding WindowsPrinterName}" Width="220" />
                        <DataGridTextColumn Header="الشركة والموديل" Binding="{Binding Manufacturer}" Width="130" />
                        <DataGridTextColumn Header="المقاسات المتاحة" Binding="{Binding SupportedPaperSizes}" Width="120" />
                        <DataGridCheckBoxColumn Header="دعم الوجهين" Binding="{Binding SupportsDuplex}" Width="90" />
                        <DataGridCheckBoxColumn Header="ألوان" Binding="{Binding SupportsColor}" Width="70" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding CurrentStatusText}" Width="120" />
                        <DataGridTemplateColumn Header="التحكم" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding IsPaused, Converter={x:Null}}"
                                            Style="{StaticResource GhostButton}"
                                            Padding="6,2" FontSize="11" Click="BtnTogglePause_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Content" Value="إيقاف مؤقت" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Content" Value="استئناف العمل" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Selected Printer Details & Saved Profiles -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="تفاصيل الماكينة وملفات الإعدادات" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <StackPanel DataContext="{Binding SelectedPrinter}" Margin="0,0,0,16">
                    <TextBlock Text="اسم الطابعة:" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding WindowsPrinterName}" FontWeight="Bold" FontSize="15" Margin="0,2,0,8" />

                    <TextBlock Text="الأدراج المتاحة:" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding AvailableTrays}" FontSize="13" Margin="0,2,0,8" />

                    <TextBlock Text="آخر خطأ مسجل:" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding LastErrorMessage, TargetNullValue='لا توجد أخطاء مسجلة'}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Separator Background="{StaticResource BorderBrush}" Margin="0,8,0,16" />

                <TextBlock Text="ملفات التعريف المحفوظة (Profiles):" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PaperSize}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
