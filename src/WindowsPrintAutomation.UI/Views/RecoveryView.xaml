<UserControl x:Class="WindowsPrintAutomation.UI.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>

        <!-- Left: List of Jobs Requiring Recovery / Verification -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="مهام تتطلب استعادة أو تأكيد فيزيائي" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="تشمل المهام المتوقفة عند انقطاع الكهرباء أو انحشار الورق أو المهام المنتهية من Spooler وبانتظار العد." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding RecoveryJobs}" SelectedItem="{Binding SelectedJob}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المهمة" Binding="{Binding JobNumber}" Width="140" />
                        <DataGridTextColumn Header="الماكينة" Binding="{Binding PrinterName}" Width="150" />
                        <DataGridTextColumn Header="المطلوب" Binding="{Binding CopiesRequested}" Width="70" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Right: Verification & Safe Resumption Panel -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="بطاقة التأكيد الفيزيائي والاستكمال الآمن" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                    <!-- Selected Job Details Card -->
                    <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel DataContext="{Binding SelectedJob}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding JobNumber}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                            </Grid>

                            <TextBlock Text="الماكينة المنفذة: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding PrinterName}" FontWeight="SemiBold" Margin="0,2,0,8" />

                            <TextBlock Text="آخر سبب / رسالة مسجلة:" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding LastErrorMessage, TargetNullValue='لا توجد رسالة خطأ'}" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Safe Copy Verification Math -->
                    <TextBlock Text="إدخال نتيجة الفحص الميداني:" FontWeight="Bold" Margin="0,0,0,8" />
                    <Border Background="{StaticResource BgPrimary}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="النسخ المطلوبة:" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding SelectedJob.CopiesRequested, FallbackValue=0}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="النسخ السليمة المؤكدة:" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBox Text="{Binding VerifiedCountInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="النسخ التالفة / المستبعدة:" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                    <TextBox Text="{Binding DamagedCountInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Calculated Remaining -->
                            <Border Background="#172554" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                <Grid>
                                    <TextBlock Text="الكمية المتبقية المطلوب استكمالها:" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RemainingCalculated}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text=" نسخ" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Operator Notes -->
                    <TextBlock Text="ملاحظات الموظف وقرار المعالجة:" Margin="0,0,0,4" Foreground="{StaticResource TextMuted}" />
                    <TextBox Text="{Binding NotesInput}" Height="60" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Status Notification Message -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Action Buttons -->
                    <UniformGrid Columns="2">
                        <Button Content="💾  تأكيد واعتماد النسخ السليمة" Style="{StaticResource SuccessButton}" Click="BtnConfirmVerification_Click" Margin="0,0,8,0" />
                        <Button Content="🔄  إنشاء مهمة استكمال للمتبقي" Style="{StaticResource PrimaryButton}" Click="BtnResumeContinuation_Click" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
