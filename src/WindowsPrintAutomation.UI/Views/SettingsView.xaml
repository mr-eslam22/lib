<UserControl x:Class="WindowsPrintAutomation.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Database & Backup Panel -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="قاعدة البيانات والنسخ الاحتياطي (SQLite WAL)" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="مسار قاعدة البيانات المحلية:" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,16" />

                <TextBlock Text="وضع التسجيل (WAL Mode):" Foreground="{StaticResource TextMuted}" FontSize="12" />
                <TextBlock Text="مفعل ومؤمن ضد انقطاع الطاقة وحوادث التعطل الفجائية" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,16" />

                <Button Content="💾  إنشاء نسخة احتياطية فورية الآن" Style="{StaticResource PrimaryButton}" Click="BtnBackup_Click" Margin="0,0,0,12" />

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- About & Machine Connection Guidelines -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="إرشادات توصيل ماكينات HP وKyocera" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="1. ماكينات Kyocera (TASKalfa / ECOSYS):" FontWeight="Bold" Margin="0,8,0,2" />
                <TextBlock Text="يفضل تثبيت تعريف KPDL / KX Driver واستخدام منفذ Standard TCP/IP مع تفعيل SNMP v1/v2c للحصول على بيانات دقيقة للأدراج ونفاد الورق." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />

                <TextBlock Text="2. ماكينات HP LaserJet:" FontWeight="Bold" Margin="0,8,0,2" />
                <TextBlock Text="استخدم HP Universal Print Driver (PostScript أو PCL6) واضبط مطابقة مقاسات A4 وB5 داخل خصائص الجهاز (Device Settings)." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />

                <TextBlock Text="3. التأكيد الفيزيائي الإلزامي:" FontWeight="Bold" Margin="0,8,0,2" />
                <TextBlock Text="لا يُعتبر خروج المهمة من طابور Windows Spooler دليلاً على خروج كل الأوراق من الماكينة؛ استخدم دائمًا شاشة التحقق الفيزيائي بعد خروج الملازم." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
